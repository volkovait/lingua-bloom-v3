{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-bloom.local/schemas/student-lesson-spec/1-0-0",
  "title": "StudentLessonSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicLessonId", "version", "title", "groups"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "publicLessonId": {
      "type": "string",
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "URL-safe capability ID generated from at least 128 bits of CSPRNG entropy"
    },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "value": { "type": "string" }
      }
    },
    "responseField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "responseKind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "responseKind": { "enum": ["choice", "text", "orderedTokens"] }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "interactionKind", "prompt", "options", "responseFields"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "interactionKind": {
          "enum": ["singleChoice", "wordOrder", "bracketGap", "oddOneOut", "wordBankGap"]
        },
        "prompt": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "responseFields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responseField" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "instruction", "exercises"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "instruction": { "type": "string" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    }
  }
}
