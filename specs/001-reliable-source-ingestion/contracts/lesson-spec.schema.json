{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-bloom.local/schemas/lesson-spec/1-0-0",
  "title": "LessonSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessonId",
    "version",
    "title",
    "sourceDocumentId",
    "documentIrId",
    "groups",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "lessonId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sourceDocumentId": { "type": "string", "minLength": 1 },
    "documentIrId": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDocumentId", "documentIrId", "blockId"],
      "properties": {
        "sourceDocumentId": { "type": "string", "minLength": 1 },
        "documentIrId": { "type": "string", "minLength": 1 },
        "blockId": { "type": "string", "minLength": 1 },
        "charStart": { "type": ["integer", "null"], "minimum": 0 },
        "charEnd": { "type": ["integer", "null"], "minimum": 0 },
        "pageIndex": { "type": ["integer", "null"], "minimum": 0 },
        "bbox": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bbox" }] }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "decisionIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "provenanceLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" },
        "reviewDecisionIds": { "$ref": "#/$defs/decisionIds" }
      },
      "oneOf": [
        {
          "required": ["sourceRefs"],
          "not": { "required": ["reviewDecisionIds"] }
        },
        {
          "required": ["reviewDecisionIds"],
          "not": { "required": ["sourceRefs"] }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "value", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "value": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenanceLink" }
      }
    },
    "answerField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptedValues", "provenance", "reviewStatus", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "acceptedValues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "provenance": {
          "enum": ["sourceKey", "teacherSupplied", "deterministicRule"]
        },
        "reviewStatus": { "const": "verified" },
        "evidence": { "$ref": "#/$defs/provenanceLink" }
      },
      "allOf": [
        {
          "if": { "properties": { "provenance": { "const": "sourceKey" } } },
          "then": { "properties": { "evidence": { "required": ["sourceRefs"] } } }
        },
        {
          "if": { "properties": { "provenance": { "const": "teacherSupplied" } } },
          "then": { "properties": { "evidence": { "required": ["reviewDecisionIds"] } } }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "interactionKind",
        "prompt",
        "provenance",
        "options",
        "answerFields"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "interactionKind": {
          "enum": ["singleChoice", "wordOrder", "bracketGap", "oddOneOut", "wordBankGap"]
        },
        "prompt": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenanceLink" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "answerFields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/answerField" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "interactionKind": { "enum": ["singleChoice", "oddOneOut"] }
            }
          },
          "then": { "properties": { "options": { "minItems": 2 } } }
        },
        {
          "if": { "properties": { "interactionKind": { "const": "wordBankGap" } } },
          "then": { "properties": { "options": { "minItems": 1 } } }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "instruction", "provenance", "exercises"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "instruction": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenanceLink" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockingIssueCount",
        "unsupportedAdditionCount",
        "unresolvedAnswerCount"
      ],
      "properties": {
        "status": { "const": "passed" },
        "blockingIssueCount": { "const": 0 },
        "unsupportedAdditionCount": { "const": 0 },
        "unresolvedAnswerCount": { "const": 0 }
      }
    }
  }
}
