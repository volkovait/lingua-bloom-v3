{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-bloom.local/schemas/lesson-spec/1-2-0",
  "title": "LessonSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessonId",
    "version",
    "title",
    "sourceDocumentId",
    "documentIrId",
    "groups",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "lessonId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceDocumentId": {
      "type": "string",
      "minLength": 1
    },
    "documentIrId": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "referenceBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceBlock"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentId",
        "documentIrId",
        "blockId"
      ],
      "properties": {
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "documentIrId": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "charStart": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "charEnd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pageIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bbox": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bbox"
            }
          ]
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "decisionIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenanceLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "reviewDecisionIds": {
          "$ref": "#/$defs/decisionIds"
        }
      },
      "oneOf": [
        {
          "required": [
            "sourceRefs"
          ],
          "not": {
            "required": [
              "reviewDecisionIds"
            ]
          }
        },
        {
          "required": [
            "reviewDecisionIds"
          ],
          "not": {
            "required": [
              "sourceRefs"
            ]
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "string"
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenanceLink"
        }
      }
    },
    "answerField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "acceptedValues",
        "provenance",
        "reviewStatus",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "acceptedValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "provenance": {
          "enum": [
            "sourceKey",
            "teacherSupplied",
            "deterministicRule"
          ]
        },
        "reviewStatus": {
          "const": "verified"
        },
        "evidence": {
          "$ref": "#/$defs/provenanceLink"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "sourceKey"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "required": [
                  "sourceRefs"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "teacherSupplied"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "required": [
                  "reviewDecisionIds"
                ]
              }
            }
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "interactionKind",
        "prompt",
        "provenance",
        "options",
        "answerFields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "interactionKind": {
          "enum": [
            "singleChoice",
            "wordOrder",
            "bracketGap",
            "oddOneOut",
            "wordBankGap",
            "inlineGap",
            "shortText",
            "matching",
            "imageChoice"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenanceLink"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answerFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/answerField"
          }
        },
        "sharedResourceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "interactionKind": {
                "enum": [
                  "singleChoice",
                  "oddOneOut",
                  "imageChoice"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "instruction",
        "provenance",
        "exercises"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "instruction": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenanceLink"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 0
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "missingBoundary": {
          "enum": [
            "start",
            "end",
            "both"
          ]
        },
        "sharedResources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sharedResource"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "completeness": {
                "const": "partial"
              }
            },
            "required": [
              "completeness"
            ]
          },
          "then": {
            "required": [
              "missingBoundary"
            ]
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockingIssueCount",
        "unsupportedAdditionCount",
        "unresolvedAnswerCount"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "blockingIssueCount": {
          "const": 0
        },
        "unsupportedAdditionCount": {
          "const": 0
        },
        "unresolvedAnswerCount": {
          "const": 0
        }
      }
    },
    "referenceLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "rawText",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "rawText": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenanceLink"
        }
      }
    },
    "referenceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "sourceOrder",
        "lines"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "sourceOrder": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/referenceLine"
          }
        }
      }
    },
    "sharedResource": {
      "oneOf": [
        {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "kind",
        "entries",
        "usagePolicy",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "const": "wordBank"
        },
        "label": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "usagePolicy": {
          "enum": [
            "useOnce",
            "reusable",
            "unspecified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenanceLink"
        }
      }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "ordinal", "kind", "entries", "usagePolicy", "provenance"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "ordinal": { "type": "integer", "minimum": 1 },
            "kind": { "const": "matchingBank" },
            "label": { "type": "string" },
            "entries": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } },
            "usagePolicy": { "const": "useOnce" },
            "provenance": { "$ref": "#/$defs/provenanceLink" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.2.0" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "groups": {
            "items": {
              "required": ["sharedResources"],
              "properties": {
                "exercises": {
                  "items": {
                    "if": {
                      "properties": { "interactionKind": { "enum": ["wordBankGap", "matching"] } },
                      "required": ["interactionKind"]
                    },
                    "then": {
                      "required": ["sharedResourceId"],
                      "properties": { "options": { "maxItems": 0 } }
                    },
                    "else": { "not": { "required": ["sharedResourceId"] } }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "items": {
              "required": [
                "sharedResources"
              ],
              "properties": {
                "exercises": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "interactionKind": {
                              "const": "wordBankGap"
                            }
                          },
                          "required": [
                            "interactionKind"
                          ]
                        },
                        "then": {
                          "required": [
                            "sharedResourceId"
                          ],
                          "properties": {
                            "options": {
                              "maxItems": 0
                            }
                          }
                        },
                        "else": {
                          "not": {
                            "required": [
                              "sharedResourceId"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "items": {
              "not": {
                "required": [
                  "sharedResources"
                ]
              },
              "properties": {
                "exercises": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "interactionKind": {
                              "const": "wordBankGap"
                            }
                          },
                          "required": [
                            "interactionKind"
                          ]
                        },
                        "then": {
                          "properties": {
                            "options": {
                              "minItems": 1
                            }
                          }
                        }
                      },
                      {
                        "not": {
                          "required": [
                            "sharedResourceId"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
