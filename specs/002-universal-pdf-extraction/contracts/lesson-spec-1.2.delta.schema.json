{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-bloom.local/contracts/lesson-spec-1.2.delta.schema.json",
  "title": "LessonSpec 1.2 Contract Additions",
  "description": "Normative additions to the feature 001 LessonSpec schema. Implementation merges these definitions into the canonical full schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exerciseAdditions", "matchingBank", "matchingExercise"],
  "properties": {
    "schemaVersion": { "const": "1.2.0" },
    "exerciseAdditions": { "$ref": "#/$defs/exerciseAdditions" },
    "matchingBank": { "$ref": "#/$defs/matchingBank" },
    "matchingExercise": { "$ref": "#/$defs/matchingExercise" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sourceOrdinal": {
      "description": "Source numbering carried by every 1.2 exercise independently from display ordinal when present in the source",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "exerciseAdditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceOrdinal": { "$ref": "#/$defs/sourceOrdinal" }
      }
    },
    "provenance": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["sourceRefs"], "properties": { "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "object" } } } },
        { "type": "object", "additionalProperties": false, "required": ["reviewDecisionIds"], "properties": { "reviewDecisionIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } }
      ]
    },
    "matchingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "sourceLabel", "value", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "matchingBank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "kind", "entries", "usagePolicy", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "kind": { "const": "matchingBank" },
        "label": { "type": "string" },
        "entries": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/matchingEntry" } },
        "usagePolicy": { "const": "useOnce" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["acceptedValues"],
      "properties": { "acceptedValues": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/id" } } }
    },
    "matchingExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "interactionKind", "prompt", "sharedResourceId", "options", "answerFields", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "sourceOrdinal": { "$ref": "#/$defs/sourceOrdinal" },
        "interactionKind": { "const": "matching" },
        "prompt": { "type": "string" },
        "sharedResourceId": { "$ref": "#/$defs/id" },
        "options": { "type": "array", "maxItems": 0 },
        "answerFields": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/answer" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
