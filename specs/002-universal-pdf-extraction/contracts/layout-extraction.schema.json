{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingua-bloom.local/contracts/layout-extraction-1.0.0.schema.json",
  "title": "Layout Extraction Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceDocumentId", "documentIrId", "lines", "regions", "candidates", "coverage"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceDocumentId": { "$ref": "#/$defs/id" },
    "documentIrId": { "$ref": "#/$defs/id" },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/reconstructedLine" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/layoutRegion" } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/exerciseCandidate" } },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectedCandidateCount", "accountedCandidateCount", "status"],
      "properties": {
        "detectedCandidateCount": { "type": "integer", "minimum": 0 },
        "accountedCandidateCount": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["passed", "needsReview", "blocked"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDocumentId", "documentIrId", "blockId"],
      "properties": {
        "sourceDocumentId": { "$ref": "#/$defs/id" },
        "documentIrId": { "$ref": "#/$defs/id" },
        "blockId": { "$ref": "#/$defs/id" },
        "pageIndex": { "type": ["integer", "null"], "minimum": 0 },
        "charStart": { "type": ["integer", "null"], "minimum": 0 },
        "charEnd": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 }
      }
    },
    "reconstructedLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageIndex", "ordinal", "rawText", "normalizedText", "bbox", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "rawText": { "type": "string" },
        "normalizedText": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontFamily": { "type": "string" },
            "fontSize": { "type": "number", "exclusiveMinimum": 0 },
            "fontWeight": { "type": "number", "minimum": 1 },
            "alignment": { "enum": ["left", "center", "right", "unknown"] }
          }
        },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "layoutRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "kind", "lineIds", "sourceRefs", "confidence", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["heading", "instruction", "question", "optionBank", "example", "boilerplate", "reference", "unknown"] },
        "lineIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "optionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "value", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "exerciseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "regionIds", "rawPrompt", "optionCandidates", "classification", "confidence", "evidence", "sourceRefs", "outcome"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceOrdinal": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
        "regionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "rawPrompt": { "type": "string" },
        "optionCandidates": { "type": "array", "items": { "$ref": "#/$defs/optionCandidate" } },
        "classification": { "enum": ["matching", "singleChoice", "bracketGap", "wordBankGap", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "suggestionProvenance": { "enum": ["deterministic", "modelInferred"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "outcome": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind", "exerciseIds"], "properties": { "kind": { "const": "exercise" }, "exerciseIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } },
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["example", "reference"] } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "issueId"], "properties": { "kind": { "const": "issue" }, "issueId": { "$ref": "#/$defs/id" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "reviewDecisionId"], "properties": { "kind": { "const": "decision" }, "reviewDecisionId": { "$ref": "#/$defs/id" } } }
          ]
        }
      }
    }
  }
}
