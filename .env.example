# Supabase server and browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only

# Direct Postgres URL for applying pending Supabase migrations (Project Settings → Database).
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# Durable workflows
INNGEST_EVENT_KEY=replace-me-server-only
INNGEST_SIGNING_KEY=replace-me-server-only

# Optional bounded answer suggestions. Keep the key server-side.
OPENAI_API_KEY=replace-me-server-only
OPENAI_BASE_URL=https://polza.ai/api/v1
OPENAI_MODEL=openai/gpt-5.4-mini
